#!/bin/sh
# Rendered by k3s-kvm-demo and piped to `/bin/sh -s <marker>` inside the guest
# via the QEMU guest agent.  The two payloads arrive base64-encoded, so nothing
# in a token, URL or SAN can terminate a quote or inject a command; the only
# other substitutions are a validated DNS-1123 label and integers.
#
# The script is idempotent and safe to re-run: reconciliation does exactly that
# after the backend restarts.
set -eu

STATE_DIR='{{ state_dir }}'
LOCK="$STATE_DIR/firstboot.lock"
STARTED="$STATE_DIR/firstboot.started"
DONE="$STATE_DIR/firstboot.done"
UNIT='{{ unit_name }}'

command -v flock >/dev/null 2>&1 || { echo "flock is not available in this image" >&2; exit 1; }
mkdir -p "$STATE_DIR"

# Serialise against a run left behind by a previous backend process.  Exit 75
# (EX_TEMPFAIL) tells the caller to back off and try again rather than to treat
# the node as broken.
exec 9>"$LOCK"
if ! flock -n 9; then
    echo "another firstboot run holds the lock" >&2
    exit 75
fi

if [ -e "$DONE" ]; then
    echo "firstboot already completed"
    exit 0
fi

# Judge the image dirty only when nothing of ours has ever run here.  Once
# k3s starts it creates its data directory, so a crash between that and the
# done marker must not be mistaken for a bad golden image.
if [ ! -e "$STARTED" ] && [ -d '{{ rancher_dir }}' ]; then
    echo "{{ rancher_dir }} already exists; expected a clean golden image" >&2
    exit 1
fi

command -v k3s >/dev/null 2>&1 || { echo "k3s is not on PATH" >&2; exit 1; }
echo "k3s: $(k3s --version 2>&1 | head -n 1)"

for packaged in k3s k3s-server k3s-agent; do
    if systemctl is-enabled "$packaged" >/dev/null 2>&1; then
        echo "packaged $packaged.service is enabled and would race $UNIT" >&2
        exit 1
    fi
done

: > "$STARTED.tmp" && mv "$STARTED.tmp" "$STARTED"

hostnamectl set-hostname '{{ node_name }}'

install -d -m 0700 '{{ config_dir }}'
printf %s '{{ config_b64 }}' | base64 -d > '{{ config_path }}.tmp'
chmod 0600 '{{ config_path }}.tmp'
mv '{{ config_path }}.tmp' '{{ config_path }}'

install -d -m 0755 "$(dirname '{{ unit_path }}')"
printf %s '{{ unit_b64 }}' | base64 -d > '{{ unit_path }}.tmp'
chmod 0644 '{{ unit_path }}.tmp'
mv '{{ unit_path }}.tmp' '{{ unit_path }}'

systemctl daemon-reload
systemctl enable "$UNIT"

# --no-block plus an explicit poll: the unit is Type=notify with no start
# timeout, so a blocking start could hang past any budget we set.
systemctl start --no-block "$UNIT"

waited=0
while [ "$waited" -lt {{ service_wait_s }} ]; do
    case "$(systemctl is-active "$UNIT" 2>/dev/null || true)" in
        active) break ;;
        failed)
            echo "$UNIT failed to start" >&2
            journalctl -u "$UNIT" -n 50 --no-pager >&2 || true
            exit 1
            ;;
    esac
    sleep 1
    waited=$((waited + 1))
done

if [ "$(systemctl is-active "$UNIT" 2>/dev/null || true)" != "active" ]; then
    echo "$UNIT did not become active within {{ service_wait_s }}s" >&2
    journalctl -u "$UNIT" -n 50 --no-pager >&2 || true
    exit 1
fi

: > "$DONE.tmp" && mv "$DONE.tmp" "$DONE"
echo "firstboot complete"
